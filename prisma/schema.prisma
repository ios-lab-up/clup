// Prisma schema — CLUP (Centro de Lenguas de la Universidad Panamericana)
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
  // SUPER_ADMIN puede agregarse después con ALTER TYPE ... ADD VALUE (no rompe nada existente)
}

enum ExamType {
  TOEIC
  TOEFL
  CUSTOM
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentType {
  PAYMENT_PROOF
  UNIVERSITY_ID_FRONT
  INE_FRONT
  INE_BACK
}

enum EmailNotificationType {
  REGISTRATION_CREATED
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
  RESULT_PUBLISHED
  EXAM_REMINDER
}

model Profile {
  id          String   @id @default(cuid())
  // Nullable: un admin puede "pre-invitar" por email antes del primer login;
  // se enlaza automáticamente la primera vez que esa persona entra con Clerk.
  clerkUserId String?  @unique
  email       String   @unique
  name        String
  // Matrícula institucional — se captura en el onboarding del primer login, se
  // usa para resolver filas del CSV de carga masiva de resultados (instructions.md §23).
  studentId   String?  @unique
  // Carrera del alumno — se captura en el onboarding. Resuelve el puntaje mínimo
  // aplicable al calificar (ver ExamPassingScore). Null para docentes/externos.
  careerId    String?
  // Campus del alumno — se captura en el onboarding (requerido para onboardings
  // nuevos). Los perfiles ya onboardeados antes de este campo quedan en null
  // hasta que lo editen en /perfil; no se re-abre el gate de onboarding por esto.
  campusId    String?
  // Marca de que el alumno completó la encuesta inicial obligatoria. Mientras
  // sea null, requireOnboarding() lo regresa a /onboarding.
  onboardedAt DateTime?
  role        Role     @default(STUDENT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  career        Career?  @relation(fields: [careerId], references: [id], onDelete: SetNull)
  campus        Campus?  @relation(fields: [campusId], references: [id], onDelete: SetNull)
  registrations Registration[]
  auditLogs     AuditLog[]

  @@index([role])
  @@index([careerId])
  @@index([campusId])
}

model Term {
  id          String   @id @default(cuid())
  name        String
  year        Int
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  examDates ExamDate[]

  @@unique([name, year])
}

model Exam {
  id           String   @id @default(cuid())
  type         ExamType
  name         String
  description  String?
  // Puntaje mínimo GENERAL (default) para aprobar. Se puede sobreescribir por
  // facultad o por carrera específica en ExamPassingScore. Editable desde admin.
  passingScore Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  examDates     ExamDate[]
  passingScores ExamPassingScore[]
}

// Catálogo institucional: facultad/escuela -> carreras. Editable desde
// Settings › Catalog en el admin. Se siembra en la migración inicial del catálogo.
model Faculty {
  id         String   @id @default(cuid())
  name       String   @unique
  slug       String   @unique
  order      Int      @default(0)
  // Bucket "DOCENTE / EXTERNO": sin carreras, sin override de puntaje; a estos
  // usuarios se les aplica el puntaje mínimo general del examen.
  isExternal Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  careers       Career[]
  passingScores ExamPassingScore[]

  @@index([order])
}

// Campus del alumno — catálogo plano, sin jerarquía (a diferencia de
// Faculty/Career). Editable en Settings › Catalog. Se siembra con los
// campus reales de la Panamericana en la propia migración (data migration).
model Campus {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles Profile[]

  @@index([order])
}

model Career {
  id        String   @id @default(cuid())
  facultyId String
  name      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faculty       Faculty            @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  profiles      Profile[]
  passingScores ExamPassingScore[]

  @@unique([facultyId, name])
  @@index([facultyId])
}

// Override del puntaje mínimo de un examen para una facultad o una carrera.
// Exactamente uno de facultyId/careerId va poblado (CHECK en la migración).
// Resolución al calificar: carrera exacta -> facultad de esa carrera -> Exam.passingScore.
model ExamPassingScore {
  id        String   @id @default(cuid())
  examId    String
  facultyId String?
  careerId  String?
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  faculty Faculty? @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  career  Career?  @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@unique([examId, facultyId])
  @@unique([examId, careerId])
  @@index([examId])
}

model ExamDate {
  id                    String   @id @default(cuid())
  termId                String
  examId                String
  examDate              DateTime
  registrationStartDate DateTime
  registrationEndDate   DateTime
  capacity              Int?
  instructions          String?
  info                  String?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  term          Term           @relation(fields: [termId], references: [id], onDelete: Restrict)
  exam          Exam           @relation(fields: [examId], references: [id], onDelete: Restrict)
  registrations Registration[]
  reminderLogs  ReminderLog[]

  @@index([termId])
  @@index([examId])
  @@index([examDate])
}

model Registration {
  id              String             @id @default(cuid())
  profileId       String
  examDateId      String
  status          RegistrationStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Restrict)
  examDate     ExamDate      @relation(fields: [examDateId], references: [id], onDelete: Restrict)
  documents    Document[]
  result       Result?
  reminderLogs ReminderLog[]

  // Imposibilita una segunda inscripción del mismo alumno a la misma fecha de examen.
  @@unique([profileId, examDateId])
  @@index([status])
  @@index([examDateId])
}

model Document {
  id             String       @id @default(cuid())
  registrationId String
  type           DocumentType
  storageKey     String
  mimeType       String
  size           Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  // Re-subir un documento reemplaza (upsert), nunca duplica.
  @@unique([registrationId, type])
}

model Result {
  id             String    @id @default(cuid())
  registrationId String    @unique
  score          Int
  passed         Boolean
  published      Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  imageKey  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

// Avisos/anuncios mostrados en la portada pública. Distinto de Instruction
// (instrucciones de proceso) — este es contenido tipo noticia, con imagen opcional.
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  imageKey  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Instruction {
  id        String   @id @default(cuid())
  title     String
  body      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Activar/desactivar cada tipo de correo desde Settings › Emails. Si no hay
// fila para un tipo, se asume enabled=true (comportamiento histórico).
model EmailSetting {
  id        String                @id @default(cuid())
  type      EmailNotificationType @unique
  enabled   Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

// Cada fila es un envío programado del recordatorio de examen ("2 días
// antes", "1 día antes", "5 minutos antes", ...) — se pueden tener varios a
// la vez. minutesBefore es la unidad interna; el admin lo captura como
// cantidad + unidad (minutos/horas/días) desde la UI.
model ReminderSchedule {
  id            String   @id @default(cuid())
  minutesBefore Int
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reminderLogs ReminderLog[]

  @@unique([minutesBefore])
}

model AuditLog {
  id             String   @id @default(cuid())
  // null = acción disparada por el sistema (ej. cron de recordatorios), sin actor humano.
  actorProfileId String?
  action         String
  entity         String
  entityId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  actor Profile? @relation(fields: [actorProfileId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorProfileId])
}

model ReminderLog {
  id                 String   @id @default(cuid())
  examDateId         String
  registrationId     String
  reminderScheduleId String
  sentAt             DateTime @default(now())

  examDate         ExamDate         @relation(fields: [examDateId], references: [id], onDelete: Cascade)
  registration     Registration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  reminderSchedule ReminderSchedule @relation(fields: [reminderScheduleId], references: [id], onDelete: Cascade)

  // Garantiza idempotencia por envío programado: con varios ReminderSchedule
  // activos, cada uno se envía una sola vez por inscripción.
  @@unique([examDateId, registrationId, reminderScheduleId])
}
